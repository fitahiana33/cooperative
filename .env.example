POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=cooperative
POSTGRES_USER=cooperative
POSTGRES_PASSWORD=cooperative_dev
POSTGRES_PORT=5432
POSTGRES_CONTAINER_PORT=5432
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=10
DATABASE_URL=postgresql+psycopg://cooperative:cooperative_dev@db:5432/cooperative
API_PORT=8000
API_CONTAINER_PORT=8000
WEB_PORT=5173
WEB_CONTAINER_PORT=5173
APP_NAME=Coopérative API
VITE_API_BASE_URL=http://localhost:8000/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1
SECRET_KEY=change-me-in-development
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30
