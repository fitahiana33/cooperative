POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=cooperative
POSTGRES_USER=cooperative
POSTGRES_PASSWORD=cooperative_dev
POSTGRES_PORT=5432
POSTGRES_CONTAINER_PORT=5432
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=10
DATABASE_URL=postgresql+psycopg://cooperative:cooperative_dev@db:5432/cooperative
API_PORT=8000
API_CONTAINER_PORT=8000
WEB_PORT=5173
WEB_CONTAINER_PORT=5173
APP_NAME=Coopérative API
VITE_API_BASE_URL=http://localhost:8000/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1
SECRET_KEY=change-me-in-development
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_ADMIN_EMAIL=admin@cooperative.com
DEFAULT_ADMIN_PASSWORD=Admin123!
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Réservations : durée de rétention des places avant paiement (minutes) et limites par passager.
RESERVATION_HOLD_MINUTES=30
PASSENGER_MAX_PENDING_RESERVATIONS=2
PASSENGER_MAX_SEATS_PER_RESERVATION=6
# Renvoie le lien de réinitialisation du mot de passe dans la réponse de l'API.
# Développement local uniquement : refusé au démarrage hors développement.
DEBUG_RETURN_RESET_URL=false
# Un passager peut annuler une réservation payée jusqu'à ce délai avant le départ (minutes).
CANCELLATION_DEADLINE_MINUTES=120
# Compteurs de limitation de débit : memory:// (un processus) ou redis://hote:6379 (plusieurs).
RATE_LIMIT_STORAGE_URI=memory://
# Adresses du proxy autorisé à transmettre l'IP du client (X-Forwarded-For), image de production.
FORWARDED_ALLOW_IPS=127.0.0.1
