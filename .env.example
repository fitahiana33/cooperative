POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=cooperative
POSTGRES_USER=cooperative
POSTGRES_PASSWORD=cooperative_dev
POSTGRES_PORT=5433
POSTGRES_CONTAINER_PORT=5432
DB_HEALTHCHECK_INTERVAL=5s
DB_HEALTHCHECK_TIMEOUT=5s
DB_HEALTHCHECK_RETRIES=10
DATABASE_URL=postgresql+psycopg://cooperative:cooperative_dev@db:5432/cooperative
API_PORT=8000
API_CONTAINER_PORT=8000
WEB_PORT=5173
WEB_CONTAINER_PORT=5173
APP_NAME=Coopérative API
VITE_API_BASE_URL=http://localhost:8000/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:8000/api/v1
SECRET_KEY=change-me-in-development
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_EMAIL=admin@cooperative.local
DEFAULT_ADMIN_PASSWORD=Admin123!
FRONTEND_URL=http://localhost:5173
DRIVER_MIN_REST_MINUTES=0
BOARDING_REQUIRES_FULL_PAYMENT=true
ONLINE_PAYMENT_ENABLED=false
PAYMENT_PROVIDER=papi
PAPI_ENV=sandbox
PAPI_BASE_URL=https://app.papi.mg/engine/api
PAPI_API_KEY=replace-with-sandbox-api-key
PAPI_SIGNING_SECRET=replace-with-sandbox-signing-secret
PAPI_NOTIFICATION_URL=https://your-public-api.example.com/api/v1/paiements/webhooks/papi
PAPI_VALID_DURATION_HOURS=1
VITE_DEFAULT_ADMIN_EMAIL=
VITE_DEFAULT_ADMIN_PASSWORD=

# Politique d’acompte validée par l’exploitant ; exposée par /reservations/policy.
DEPOSIT_RATE=0.25
MINIMUM_DEPOSIT_AMOUNT=300

# Notifications SMTP : activer uniquement avec la configuration du serveur de messagerie.
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
