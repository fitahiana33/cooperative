+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../../core/errors/user_error.dart';
+import '../../../core/theme/app_theme.dart';
+import '../../../core/utils/formatters.dart';
+import '../../../data/models/travel/travel_models.dart';
+import '../../../data/repositories/travel/travel_repository_impl.dart';
+import '../../widgets/common/error_banner.dart';
+import '../../widgets/travel/status_chip.dart';
+import 'departure_page.dart';
+
+/// Search a trip by origin, destination and date; only bookable departures are listed.
+class TripSearchPage extends ConsumerStatefulWidget {
+  const TripSearchPage({super.key});
+
+  @override
+  ConsumerState<TripSearchPage> createState() => _TripSearchPageState();
+}
+
+class _TripSearchPageState extends ConsumerState<TripSearchPage> {
+  List<Destination> _destinations = [];
+  int? _originId;
+  int? _destinationId;
+  DateTime _date = DateTime.now();
+  final List<Departure> _results = [];
+  int _page = 1;
+  bool _hasMore = false;
+  bool _searched = false;
+  bool _loading = false;
+  bool _loadingDestinations = true;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadDestinations();
+  }
+
+  Future<void> _loadDestinations() async {
+    setState(() { _loadingDestinations = true; _error = null; });
+    try {
+      final values = await ref.read(travelRepositoryProvider).listDestinations();
+      if (mounted) setState(() => _destinations = values);
+    } catch (error) {
+      if (mounted) setState(() => _error = userError(error, 'Impossible de charger les villes.', 'MOBILE_DESTINATIONS_ERROR'));
+    } finally {
+      if (mounted) setState(() => _loadingDestinations = false);
+    }
+  }
+
+  Future<void> _search({bool more = false}) async {
+    if (_loading) return;
+    setState(() { _loading = true; _error = null; if (!more) { _page = 1; _results.clear(); } });
+    try {
+      final result = await ref.read(travelRepositoryProvider).searchDepartures(
+            originId: _originId,
+            destinationId: _destinationId,
+            date: _date,
+            page: more ? _page + 1 : 1,
+          );
+      if (!mounted) return;
+      setState(() {
+        _results.addAll(result.items);
+        _page = result.page;
+        _hasMore = result.hasMore;
+        _searched = true;
+      });
+    } catch (error) {
+      if (mounted) setState(() => _error = userError(error, 'La recherche a échoué.', 'MOBILE_SEARCH_ERROR'));
+    } finally {
+      if (mounted) setState(() => _loading = false);
+    }
+  }
+
+  Future<void> _pickDate() async {
+    final today = DateTime.now();
+    final picked = await showDatePicker(
+      context: context,
+      initialDate: _date,
+      firstDate: DateTime(today.year, today.month, today.day),
+      lastDate: today.add(const Duration(days: 90)),
+      locale: const Locale('fr', 'FR'),
+    );
+    if (picked != null) setState(() => _date = picked);
+  }
+
+  void _swap() => setState(() {
+        final origin = _originId;
+        _originId = _destinationId;
+        _destinationId = origin;
+      });
+
+  Widget _cityField(String label, int? value, ValueChanged<int?> onChanged) => DropdownButtonFormField<int?>(
+        initialValue: value,
+        isExpanded: true,
+        decoration: InputDecoration(labelText: label, border: const OutlineInputBorder()),
+        items: [
+          const DropdownMenuItem<int?>(value: null, child: Text('Toutes les villes')),
+          ..._destinations.map((city) => DropdownMenuItem<int?>(value: city.id, child: Text(city.name))),
+        ],
+        onChanged: onChanged,
+      );
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        appBar: AppBar(title: const Text('Rechercher un voyage')),
+        body: ListView(padding: const EdgeInsets.all(16), children: [
+          if (_loadingDestinations) const LinearProgressIndicator(),
+          Row(crossAxisAlignment: CrossAxisAlignment.center, children: [
+            Expanded(child: Column(children: [
+              _cityField('Départ', _originId, (value) => setState(() => _originId = value)),
+              const SizedBox(height: 12),
+              _cityField('Arrivée', _destinationId, (value) => setState(() => _destinationId = value)),
+            ])),
+            IconButton(tooltip: 'Inverser départ et arrivée', onPressed: _swap, icon: const Icon(Icons.swap_vert)),
+          ]),
+          const SizedBox(height: 12),
+          OutlinedButton.icon(
+            onPressed: _pickDate,
+            icon: const Icon(Icons.calendar_today),
+            label: Text('Date : ${Fmt.date(Fmt.apiDate(_date))}'),
+          ),
+          const SizedBox(height: 12),
+          ElevatedButton.icon(
+            onPressed: _loading ? null : () => _search(),
+            icon: const Icon(Icons.search),
+            label: Text(_loading && _results.isEmpty ? 'Recherche…' : 'Rechercher'),
+          ),
+          const SizedBox(height: 16),
+          if (_error != null) ...[ErrorBanner(message: _error!), const SizedBox(height: 12)],
+          if (_searched && _results.isEmpty && !_loading)
+            const Padding(
+              padding: EdgeInsets.symmetric(vertical: 24),
+              child: Text('Aucun départ réservable pour ces critères. Essayez une autre date.', textAlign: TextAlign.center, style: TextStyle(color: Colors.white70)),
+            ),
+          ..._results.map(_departureCard),
+          if (_hasMore)
+            TextButton(onPressed: _loading ? null : () => _search(more: true), child: Text(_loading ? 'Chargement…' : 'Voir plus de départs')),
+        ]),
+      );
+
+  Widget _departureCard(Departure departure) => Card(
+        color: AppTheme.surface,
+        margin: const EdgeInsets.only(bottom: 12),
+        child: InkWell(
+          borderRadius: BorderRadius.circular(12),
+          onTap: () async {
+            await Navigator.push(context, MaterialPageRoute(builder: (_) => DeparturePage(departure: departure)));
+            if (mounted) _search();
+          },
+          child: Padding(
+            padding: const EdgeInsets.all(14),
+            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+              Row(children: [
+                Text(Fmt.time(departure.time), style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold)),
+                const SizedBox(width: 12),
+                Expanded(child: Text('${departure.origin} → ${departure.destination}', style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w600))),
+                StatusChip(departure.status),
+              ]),
+              const SizedBox(height: 8),
+              Text('${departure.cooperative} · ${departure.vehiclePlate}', style: const TextStyle(color: Colors.white70)),
+              const SizedBox(height: 6),
+              Row(children: [
+                const Icon(Icons.event_seat, size: 16, color: Colors.white54),
+                const SizedBox(width: 4),
+                Text('${departure.freeSeats} / ${departure.seats} places libres', style: const TextStyle(color: Colors.white70)),
+                const Spacer(),
+                Text(Fmt.money(departure.price, departure.currency), style: const TextStyle(fontSize: 16, fontWeight: FontWeight.bold, color: AppTheme.primaryAccent)),
+              ]),
+            ]),
+          ),
+        ),
+      );
+}
diff --git a/mobile/lib/presentation/widgets/common/async_view.dart b/mobile/lib/presentation/widgets/common/async_view.dart
new file mode 100644
index 0000000..2c9c1ee
--- /dev/null
+++ b/mobile/lib/presentation/widgets/common/async_view.dart
@@ -0,0 +1,54 @@
+import 'package:flutter/material.dart';
+
+/// Loading, error (with retry) and empty states shared by the list screens.
+class AsyncView extends StatelessWidget {
+  final bool loading;
+  final String? error;
+  final bool empty;
+  final String emptyMessage;
+  final IconData emptyIcon;
+  final VoidCallback onRetry;
+  final Widget child;
+
+  const AsyncView({
+    super.key,
+    required this.loading,
+    required this.error,
+    required this.empty,
+    required this.emptyMessage,
+    required this.onRetry,
+    required this.child,
+    this.emptyIcon = Icons.inbox_outlined,
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    if (loading) return const Center(child: CircularProgressIndicator());
+    if (error != null || empty) {
+      // Scrollable so pull-to-refresh also works on an empty or failed list.
+      return LayoutBuilder(
+        builder: (context, constraints) => SingleChildScrollView(
+          physics: const AlwaysScrollableScrollPhysics(),
+          child: ConstrainedBox(
+            constraints: BoxConstraints(minHeight: constraints.maxHeight),
+            child: Center(
+              child: Padding(
+                padding: const EdgeInsets.all(24),
+                child: Column(mainAxisSize: MainAxisSize.min, children: [
+                  Icon(error != null ? Icons.cloud_off_rounded : emptyIcon, size: 48, color: Colors.white38),
+                  const SizedBox(height: 12),
+                  Text(error ?? emptyMessage, textAlign: TextAlign.center, style: const TextStyle(color: Colors.white70)),
+                  if (error != null) ...[
+                    const SizedBox(height: 16),
+                    OutlinedButton.icon(onPressed: onRetry, icon: const Icon(Icons.refresh), label: const Text('Réessayer')),
+                  ],
+                ]),
+              ),
+            ),
+          ),
+        ),
+      );
+    }
+    return child;
+  }
+}
diff --git a/mobile/lib/presentation/widgets/travel/seat_map.dart b/mobile/lib/presentation/widgets/travel/seat_map.dart
new file mode 100644
index 0000000..091f2a4
--- /dev/null
+++ b/mobile/lib/presentation/widgets/travel/seat_map.dart
@@ -0,0 +1,140 @@
+import 'package:flutter/material.dart';
+
+import '../../../core/theme/app_theme.dart';
+import '../../../data/models/travel/travel_models.dart';
+
+/// Seat map following the vehicle model's layout: seats beside the driver,
+/// then rows of [seatsPerRow] with an aisle in the middle.
+class SeatMap extends StatelessWidget {
+  final List<Seat> seats;
+  final Set<int> selected;
+  final int seatsBesideDriver;
+  final int seatsPerRow;
+  final bool enabled;
+  final ValueChanged<Seat> onToggle;
+
+  const SeatMap({
+    super.key,
+    required this.seats,
+    required this.selected,
+    required this.seatsBesideDriver,
+    required this.seatsPerRow,
+    required this.onToggle,
+    this.enabled = true,
+  });
+
+  static const free = Color(0xFF10B981);
+  static const reserved = Color(0xFFF59E0B);
+  static const occupied = Color(0xFFEF4444);
+  static const blocked = Color(0xFF64748B);
+
+  static const _labels = {'DISPONIBLE': 'disponible', 'RESERVEE': 'réservée', 'OCCUPEE': 'occupée', 'BLOQUEE': 'bloquée'};
+
+  Color _color(Seat seat) {
+    if (selected.contains(seat.id)) return AppTheme.primary;
+    switch (seat.status) {
+      case 'RESERVEE':
+        return reserved;
+      case 'OCCUPEE':
+        return occupied;
+      case 'BLOQUEE':
+        return blocked;
+      default:
+        return free;
+    }
+  }
+
+  Widget _seat(Seat seat) {
+    final isSelected = selected.contains(seat.id);
+    final state = isSelected ? 'sélectionnée' : _labels[seat.status] ?? seat.status;
+    return Semantics(
+      button: seat.isFree,
+      selected: isSelected,
+      enabled: enabled && seat.isFree,
+      label: 'Place ${seat.number}, $state',
+      excludeSemantics: true,
+      child: GestureDetector(
+        onTap: enabled && seat.isFree ? () => onToggle(seat) : null,
+        child: AnimatedContainer(
+          duration: const Duration(milliseconds: 150),
+          width: 44,
+          height: 44,
+          margin: const EdgeInsets.all(3),
+          alignment: Alignment.center,
+          decoration: BoxDecoration(
+            color: _color(seat),
+            borderRadius: BorderRadius.circular(10),
+            border: Border.all(color: Colors.white.withValues(alpha: isSelected ? 0.9 : 0.3), width: isSelected ? 2 : 1),
+          ),
+          child: Text('${seat.number}', style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
+        ),
+      ),
+    );
+  }
+
+  Widget _row(List<Seat> row) {
+    final aisle = (seatsPerRow / 2).ceil();
+    final children = <Widget>[];
+    for (var index = 0; index < row.length; index++) {
+      if (index == aisle) children.add(const SizedBox(width: 18));
+      children.add(_seat(row[index]));
+    }
+    return Row(mainAxisAlignment: MainAxisAlignment.center, children: children);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final front = seats.take(seatsBesideDriver).toList();
+    final back = seats.skip(seatsBesideDriver).toList();
+    final rows = <List<Seat>>[];
+    for (var index = 0; index < back.length; index += seatsPerRow) {
+      rows.add(back.sublist(index, (index + seatsPerRow).clamp(0, back.length)));
+    }
+    return Column(children: [
+      Wrap(alignment: WrapAlignment.center, spacing: 12, runSpacing: 6, children: [
+        _legend(free, 'Disponible'),
+        _legend(AppTheme.primary, 'Sélectionnée'),
+        _legend(reserved, 'Réservée'),
+        _legend(occupied, 'Occupée'),
+        _legend(blocked, 'Bloquée'),
+      ]),
+      const SizedBox(height: 12),
+      Container(
+        width: double.infinity,
+        padding: const EdgeInsets.symmetric(vertical: 16, horizontal: 8),
+        decoration: BoxDecoration(color: const Color(0xFF172554), borderRadius: BorderRadius.circular(18), border: Border.all(color: Colors.white12)),
+        child: FittedBox(
+          fit: BoxFit.scaleDown,
+          child: Column(children: [
+            Row(mainAxisAlignment: MainAxisAlignment.center, children: [
+              _driverSeat(),
+              const SizedBox(width: 18),
+              ...front.map(_seat),
+            ]),
+            const SizedBox(width: 200, child: Divider(color: Colors.white24, height: 20)),
+            ...rows.map(_row),
+          ]),
+        ),
+      ),
+    ]);
+  }
+
+  Widget _legend(Color color, String label) => Row(mainAxisSize: MainAxisSize.min, children: [
+        Container(width: 12, height: 12, decoration: BoxDecoration(color: color, borderRadius: BorderRadius.circular(3))),
+        const SizedBox(width: 5),
+        Text(label, style: const TextStyle(color: Colors.white70, fontSize: 12)),
+      ]);
+
+  Widget _driverSeat() => Semantics(
+        label: 'Chauffeur',
+        excludeSemantics: true,
+        child: Container(
+          width: 48,
+          height: 48,
+          margin: const EdgeInsets.all(3),
+          alignment: Alignment.center,
+          decoration: BoxDecoration(color: const Color(0xFF475569), borderRadius: BorderRadius.circular(10), border: Border.all(color: Colors.white24)),
+          child: const Icon(Icons.airline_seat_recline_normal, size: 22, color: Colors.white70),
+        ),
+      );
+}
