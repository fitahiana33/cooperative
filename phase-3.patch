diff --git a/mobile/test/formatters_test.dart b/mobile/test/formatters_test.dart
new file mode 100644
index 0000000..d57336b
--- /dev/null
+++ b/mobile/test/formatters_test.dart
@@ -0,0 +1,29 @@
+import 'package:cooperative_mobile/core/utils/formatters.dart';
+import 'package:cooperative_mobile/core/utils/reset_link.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:intl/date_symbol_data_local.dart';
+
+void main() {
+  setUpAll(() => initializeDateFormatting('fr_FR'));
+
+  test('amounts are shown in ariary with French grouping', () {
+    expect(Fmt.money('45000.00', 'MGA').replaceAll(' ', ' ').replaceAll(' ', ' '), '45 000 Ar');
+    expect(Fmt.money(1500, 'EUR').endsWith('EUR'), isTrue);
+  });
+
+  test('times drop the seconds', () {
+    expect(Fmt.time('08:00:00'), '08:00');
+    expect(Fmt.time(null), '—');
+  });
+
+  test('statuses are readable French labels', () {
+    expect(Fmt.status('EN_ATTENTE'), 'En attente de paiement');
+    expect(Fmt.status('PROGRAMME'), 'Programmé');
+    expect(Fmt.status('INCONNU'), 'INCONNU');
+  });
+
+  test('reset token is read from the emailed link or typed directly', () {
+    expect(extractResetToken('http://localhost:5173/forgot-password?token=abc.def'), 'abc.def');
+    expect(extractResetToken('  abc.def  '), 'abc.def');
+  });
+}
diff --git a/mobile/test/models_test.dart b/mobile/test/models_test.dart
new file mode 100644
index 0000000..96a0a2a
--- /dev/null
+++ b/mobile/test/models_test.dart
@@ -0,0 +1,45 @@
+import 'package:cooperative_mobile/data/models/travel/travel_models.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('departure parsing is tolerant of missing optional fields', () {
+    final departure = Departure.fromJson({
+      'id': 7,
+      'date_depart': '2026-10-09',
+      'heure_depart': '07:00:00',
+      'nombre_places': 22,
+      'places_disponibles': '5',
+      'statut': 'PROGRAMME',
+      'tarif': {'prix': '35000.00', 'devise': 'MGA'},
+    });
+    expect(departure.origin, '?');
+    expect(departure.freeSeats, 5);
+    expect(departure.price, 35000);
+    expect(departure.seatsPerRow, 4);
+    expect(departure.isBookable, isTrue);
+  });
+
+  test('a full or departed trip is not bookable', () {
+    Departure make(String status, int free) => Departure.fromJson({'id': 1, 'statut': status, 'places_disponibles': free});
